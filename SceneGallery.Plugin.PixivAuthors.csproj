<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SceneGallery.Plugin.PixivAuthors</RootNamespace>
    <!-- Produces a deps.json and copy-local dependencies so the app's
         AssemblyDependencyResolver can resolve this plugin's references. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
    <SceneGalleryAppDir Condition="'$(SceneGalleryAppDir)' == ''">$(MSBuildThisFileDirectory)..\KoikatsuSceneGallery</SceneGalleryAppDir>
    <DefaultItemExcludes>$(DefaultItemExcludes);SceneGallery.Plugin.PixivAuthors.Tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.9" />
    <PackageReference Include="SceneGallery.PluginSdk" Version="1.0.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SceneGallery.Plugin.PixivAuthors.Tests" />
  </ItemGroup>

  <!--
    After each build, copy the plugin output into the app's Plugins\PixivAuthors\
    folder so the app picks it up automatically without a manual copy step.
    Override AppRid on the command line if your machine is not win-x64.
  -->
  <PropertyGroup>
    <AppRid Condition="'$(AppRid)' == ''">win-x64</AppRid>
    <DeployPluginToApp Condition="'$(DeployPluginToApp)' == ''">true</DeployPluginToApp>
    <AppPluginsDir>$(SceneGalleryAppDir)\bin\$(Configuration)\net10.0-windows10.0.26100.0\$(AppRid)\Plugins\PixivAuthors</AppPluginsDir>
  </PropertyGroup>

  <Target Name="CopyToAppPlugins" AfterTargets="Build" Condition="'$(DeployPluginToApp)' == 'true' and Exists('$(SceneGalleryAppDir)')">
    <Message Text="Plugin (folder) → $(AppPluginsDir)" Importance="high" />
    <ItemGroup>
      <_PluginFiles Include="$(OutDir)**\*" Exclude="$(OutDir)**\SceneGallery.PluginSdk.*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_PluginFiles)"
      DestinationFolder="$(AppPluginsDir)\%(RecursiveDir)"
      SkipUnchangedFiles="true" />
  </Target>

  <!-- Single-file deployment: copy just the DLL into the Plugins root -->
  <PropertyGroup>
    <AppPluginsRoot>$(SceneGalleryAppDir)\bin\$(Configuration)\net10.0-windows10.0.26100.0\$(AppRid)\Plugins</AppPluginsRoot>
  </PropertyGroup>

  <Target Name="CopySingleFilePlugin" AfterTargets="Build" Condition="'$(DeployPluginToApp)' == 'true' and Exists('$(SceneGalleryAppDir)')">
    <Message Text="Plugin (single) → $(AppPluginsRoot)\$(AssemblyName).dll" Importance="high" />
    <Copy
      SourceFiles="$(OutDir)$(AssemblyName).dll"
      DestinationFolder="$(AppPluginsRoot)"
      SkipUnchangedFiles="true" />
  </Target>

</Project>
